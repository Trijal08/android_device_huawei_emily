soong_namespace {
}

install_symlink {
    name: "vulkan_32_symlink",
    vendor: true,
    installed_location: "lib/hw/vulkan.kirin970.so",
    symlink_target: "/vendor/lib/egl/libGLES_mali.so",
}

install_symlink {
    name: "vulkan_64_symlink",
    vendor: true,
    installed_location: "lib64/hw/vulkan.kirin970.so",
    symlink_target: "/vendor/lib64/egl/libGLES_mali.so",
}

