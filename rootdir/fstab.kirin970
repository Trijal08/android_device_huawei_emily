# Android fstab file.
#<src>                                                  <mnt_point>         <type>    <mnt_flags and options>                       <fs_mgr_flags>
# The filesystem that contains the filesystem checker binary (typically /system) cannot
# specify MF_CHECK, and must come before any filesystems that do specify MF_CHECK
#/dev/block/bootdevice/by-name/system  /system    ext4    ro    wait,avb
#/dev/block/bootdevice/by-name/vendor  /vendor ext4    ro    wait,avb
#/dev/block/bootdevice/by-name/product   /product   ext4    ro    wait
#/dev/block/bootdevice/by-name/version   /version   ext4    ro    wait
#/dev/block/bootdevice/by-name/cust /cust ext4    ro    wait
#/dev/block/bootdevice/by-name/odm     /odm      ext4    ro    wait

/dev/block/by-name/userdata         			/data		f2fs	nosuid,nodev,noatime,discard,inline_data,inline_xattr	wait,check,reservedsize=20M

/dev/block/by-name/cache         			/cache		ext4	rw,nosuid,nodev,noatime,data=ordered	wait,check,nofail
/dev/block/by-name/misc       				/misc		emmc	defaults	defaults

/dev/block/by-name/secure_storage 			/sec_storage	ext4	rw,nosuid,nodev,discard,auto_da_alloc,mblk_io_submit,data=journal,context=u:object_r:teecd_data_file:s0	wait,nofail 

/dev/block/by-name/splash2         			/splash2	ext4	rw,nosuid,nodev,noatime,data=ordered,context=u:object_r:splash_data_file:s0	wait,check,nofail

/dev/block/by-name/kernel				/boot		emmc	defaults	recoveryonly
/dev/block/by-name/recovery_ramdisk			/recovery	emmc	defaults	recoveryonly

/devices/hisi_usb@ff200000/ff100000.dwc3/*              auto		auto	defaults	voldmanaged=usbotg:auto
/devices/platform/hisi_usb@ff200000/ff100000.dwc3/*     auto		auto	defaults	voldmanaged=usbotg:auto
/devices/platform/e7f00000.hifi_usb/*     		auto		auto	defaults	voldmanaged=usbotg:auto

/dev/block/zram0             				none		swap	defaults	zramsize=50%
