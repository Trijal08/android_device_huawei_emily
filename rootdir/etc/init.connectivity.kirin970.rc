on early-init
    setprop wifi.interface wlan0
    setprop wifi.direct.interface p2p-dev-wlan0

on post-fs-data
    mkdir /data/vendor/wifi 0771 wifi wifi
    mkdir /data/vendor/wifi/hostapd 0770 wifi wifi
    mkdir /data/vendor/wifi/hostapd/sockets 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa/sockets 0770 wifi wifi
    chown wifi wifi /data/vendor/wifi
    chown wifi wifi /data/vendor/wpa/wifi/p2p_supplicant.conf
    chmod 0660 /data/vendor/wpa/wifi/p2p_supplicant.conf
    restorecon_recursive /data/vendor/wifi
    
    mkdir /data/vendor/gps
    mkdir /data/vendor/log/gps_log
    chmod 775 /data/vendor/log/gps_log
    chown gps system /data/vendor/log/gps_log

    mkdir /data/vendor/log/gps_log/.tmp
    chmod 775 /data/vendor/log/gps_log/.tmp
    chown gps system /data/vendor/log/gps_log/.tmp

    mkdir /data/vendor/log/gps_log/gps
    mkdir /data/vendor/log/gps_log/lhd
    chmod 775 /data/vendor/log/gps_log/gps
    chmod 775 /data/vendor/log/gps_log/lhd
    chown gps system /data/vendor/log/gps_log/gps
    chown gps system /data/vendor/log/gps_log/lhd

    mkdir /data/vendor/log/gps_log/gps/.tmp
    mkdir /data/vendor/log/gps_log/lhd/.tmp
    chmod 775 /data/vendor/log/gps_log/gps/.tmp
    chmod 775 /data/vendor/log/gps_log/lhd/.tmp
    chown gps system /data/vendor/log/gps_log/gps/.tmp
    chown gps system /data/vendor/log/gps_log/lhd/.tmp

    mkdir /data/vendor/log/gps_log/log
    chmod 775 /data/vendor/log/gps_log/log
    chown root system /data/vendor/log/gps_log/log

    chown gps system /data/vendor/gps
    chmod 775 /data/vendor/gps
    chmod 660 /data/vendor/gps/.flp.interface.pipe.to_gpsd
    chmod 660 /data/vendor/gps/.flp.interface.pipe.to_jni
    chmod 660 /data/vendor/gps/.gps.interface.pipe.to_gpsd
    chmod 660 /data/vendor/gps/.gps.interface.pipe.to_jni
    chmod 660 /data/vendor/gps/.pipe.gpsd_to_lhd.to_client
    chmod 660 /data/vendor/gps/.pipe.gpsd_to_lhd.to_server
    chmod 660 /data/vendor/gps/.pipe.lppe.to_fd
    chmod 660 /data/vendor/gps/.pipe.lppe.to_gpsd

on boot
    # change permissions for bluetooth
    chmod 660 /dev/ttyAMA4
    chown bluetooth bluetooth /dev/ttyAMA4
    
    # bluetooth power up/down interface
    chown bluetooth bluetooth /sys/class/rfkill/rfkill0/type
    chown bluetooth bluetooth /sys/class/rfkill/rfkill0/state
    chmod 0774 /sys/class/rfkill/rfkill0/state
    
    # bluesleep start/stop interface
    chown bluetooth bluetooth /proc/bluetooth/sleep/proto
    chmod 664 /proc/bluetooth/sleep/proto
    chown bluetooth bluetooth /proc/bluetooth/sleep/btwrite
    chmod 664 /proc/bluetooth/sleep/btwrite
    chown bluetooth bluetooth /proc/bluetooth/sleep/btwake
    chmod 664 /proc/bluetooth/sleep/btwake
    chown bluetooth bluetooth /proc/bluetooth_power/data/calibrate
    chmod 664 /proc/bluetooth_power/data/calibrate

    # for bluetooth mac
    mkdir /data/vendor/bluedroid 02770 bluetooth bluetooth
    
    # enable apk to control the fwlog output
    chown system system /sys/module/bcmdhd/parameters/dhd_console_ms
    chown system system /sys/bcm-dhd/dhd_watchdog_time
    chown system system /sys/devices/platform/bcmdhd_wlan.1/wifi_arp_timeout
    chown system system /sys/kernel/debug/bcmdhd/debug_sdio_quality
    chown system system /sys/kernel/debug/bcmdhd/debug_wl_counters
    chown system system /sys/kernel/debug/bcmdhd/debug_otp
    chmod 0440 /sys/kernel/debug/bcmdhd/debug_sdio_quality
    chmod 0440 /sys/kernel/debug/bcmdhd/debug_wl_counters
    chmod 0660 /sys/kernel/debug/bcmdhd/debug_otp
    
    # control vio from framework
    chown system system /dev/vio
    
    # control wlanfty_status from framework
    chown system system /dev/wlanfty_status
    chmod 400 /dev/wlanfty_status
    
    # control wlanfty_ver from framework
    chown system system /dev/wlanfty_ver
    chmod 400 /dev/wlanfty_ver
    chown system system /dev/wlanfty_common
    
    # control wifi firmware path
    chown wifi wifi /sys/module/bcmdhd/parameters/firmware_path
    chown wifi wifi /sys/module/bcmdhd/parameters/nvram_path
    
    # write Region
    chown system system /sys/module/bcmdhd/parameters/region
    write /sys/module/bcmdhd/parameters/region ${ro.product.locale.region}
    
    # rps function
    write /sys/class/net/wlan0/queues/rx-0/rps_cpus ff
    write /sys/class/net/wlan0/queues/rx-0/rps_flow_cnt 4096
    
    # For serial port.
    chown root system /dev/ttyAMA3
    chmod 0664 /dev/ttyAMA3
    chown root system /dev/ttyAMA5
    chmod 0664 /dev/ttyAMA5
    chown root system /dev/gpstty
    chmod 0660 /dev/gpstty
    chown gps system /dev/appvcom9
    chmod 0660 /dev/appvcom9
    # For GPIOs for REG_PU and nReset
    chown root system /proc/gps/nstandby
    chmod 0664 /proc/gps/nstandby

service gpsdaemon /vendor/bin/gpsdaemon
    class late_start
    user root
    group root system
    oneshot

service fusd /vendor/bin/fusion_daemon
    class late_start
    user system
    group system root wakelock

service vendor.lhd_4774  /vendor/bin/lhd4774  /data/vendor/gps/lhd.conf
    class late_start
    user gps
    group system inet net_raw sdcard_rw wakelock
    ioprio be 0

service vendor.gpsd_4774  /vendor/bin/glgps4774 -c /data/vendor/gps/gpsconfig.xml
    socket gps seqpacket 660 gps system
    class late_start
    user root
    group system inet sdcard_rw wakelock
