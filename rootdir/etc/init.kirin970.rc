    chmod 0660 /sys/class/hw_power/soc_control/control
    chown system system /sys/class/hw_power/soc_control/control
    chmod 0660 /sys/class/hw_power/soc_control/strategy
    chown system system /sys/class/hw_power/soc_control/strategy
    start bms_soc
    
    chmod 0660 /sys/class/hw_power/interface/iin_thermal
    chown system system /sys/class/hw_power/interface/iin_thermal
    chmod 0660 /sys/class/hw_power/interface/iin_limit
    chown system system /sys/class/hw_power/interface/iin_limit
    chmod 0660 /sys/class/hw_power/interface/iin_thermal_all
    chown system system /sys/class/hw_power/interface/iin_thermal_all
    start bms_thermal
    
    chmod 0444 /sys/devices/virtual/android_usb/android0/switch_index
    chown system system /sys/devices/virtual/android_usb/android0/switch_index
    start usb_port

    start bms_alarm
    start bms_behavior
    class_start charger

on property:service.bootanim.exit=1
    write /proc/balong/stats/boot_time 1

on property:sys.boot_completed=1
    swapon_all /vendor/etc/fstab.kirin970
    chown system  system /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor
    chmod 0660 /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor
    chown system  system /sys/devices/system/cpu/cpu0/cpufreq/scaling_setspeed
    chmod 0660 /sys/devices/system/cpu/cpu0/cpufreq/scaling_setspeed
    chown system  system /sys/devices/system/cpu/cpu4/cpufreq/scaling_governor
    chmod 0660 /sys/devices/system/cpu/cpu4/cpufreq/scaling_governor
    chown system  system /sys/devices/system/cpu/cpu4/cpufreq/scaling_setspeed
    chmod 0660 /sys/devices/system/cpu/cpu4/cpufreq/scaling_setspeed

    # schedutil config
    write /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor schedutil
    restorecon_recursive /sys/devices/system/cpu/cpu0/cpufreq/schedutil
    write /sys/devices/system/cpu/cpu0/cpufreq/schedutil/go_hispeed_load 95
    write /sys/devices/system/cpu/cpu0/cpufreq/schedutil/hispeed_freq 1402000
    write /sys/devices/system/cpu/cpu0/cpufreq/schedutil/target_loads 75:1018000:85:1402000:90:1556000:90:1690000:95
    write /sys/devices/system/cpu/cpu0/cpufreq/schedutil/above_hispeed_delay 19000
    write /sys/devices/system/cpu/cpu0/cpufreq/schedutil/min_sample_time 59000
    write /sys/devices/system/cpu/cpu0/cpufreq/schedutil/boostpulse_duration 160000
    write /sys/devices/system/cpu/cpu0/cpufreq/schedutil/fast_ramp_down 1
    write /sys/devices/system/cpu/cpu0/cpufreq/schedutil/fast_ramp_up 1
    write /sys/devices/system/cpu/cpu0/cpufreq/schedutil/top_task_hist_size 3
    write /sys/devices/system/cpu/cpu0/cpufreq/schedutil/top_task_stats_policy 1
    write /sys/devices/system/cpu/cpu0/cpufreq/schedutil/ed_task_running_duration 120000000
    write /sys/devices/system/cpu/cpu0/cpufreq/schedutil/ed_new_task_running_duration 120000000
    write /sys/devices/system/cpu/cpu0/cpufreq/schedutil/io_is_busy 1
    chown system system /sys/devices/system/cpu/cpu0/cpufreq/schedutil/iowait_boost_step
    chmod 0660 /sys/devices/system/cpu/cpu0/cpufreq/schedutil/iowait_boost_step

    write /sys/devices/system/cpu/cpu4/cpufreq/scaling_governor schedutil
    write /sys/devices/system/cpu/cpu4/cpufreq/schedutil/go_hispeed_load 90
    write /sys/devices/system/cpu/cpu4/cpufreq/schedutil/hispeed_freq 1364000
    write /sys/devices/system/cpu/cpu4/cpufreq/schedutil/target_loads 80:1498000:85:1652000:95
    write /sys/devices/system/cpu/cpu4/cpufreq/schedutil/above_hispeed_delay 39000:1498000:79000:1652000:19000
    write /sys/devices/system/cpu/cpu4/cpufreq/schedutil/min_sample_time 19000
    write /sys/devices/system/cpu/cpu4/cpufreq/schedutil/timer_slack 39000
    write /sys/devices/system/cpu/cpu4/cpufreq/schedutil/fast_ramp_down 1
    write /sys/devices/system/cpu/cpu4/cpufreq/schedutil/fast_ramp_up 0
    write /sys/devices/system/cpu/cpu4/cpufreq/schedutil/top_task_hist_size 3
    write /sys/devices/system/cpu/cpu4/cpufreq/schedutil/top_task_stats_policy 2
    write /sys/devices/system/cpu/cpu4/cpufreq/schedutil/ed_task_running_duration 240000000
    write /sys/devices/system/cpu/cpu4/cpufreq/schedutil/ed_new_task_running_duration 240000000
    write /sys/devices/system/cpu/cpu4/cpufreq/schedutil/top_task_stats_empty_window 1
    write /sys/devices/system/cpu/cpu4/cpufreq/schedutil/io_is_busy 1
    chown system system /sys/devices/system/cpu/cpu4/cpufreq/schedutil/iowait_boost_step
    chmod 0660 /sys/devices/system/cpu/cpu4/cpufreq/schedutil/iowait_boost_step

    chown system system /sys/kernel/debug/freqdump/loadmonitor_enable
    chmod 660 /sys/kernel/debug/freqdump/loadmonitor_enable
    chown system system /sys/kernel/debug/freqdump/loadmonitor_disable
    chmod 660 /sys/kernel/debug/freqdump/loadmonitor_disable

    write /sys/kernel/eas/boost 0
    write /sys/kernel/eas/boot_boost 0
    write /sys/kernel/eas/capacity_margin 2048
    write /sys/kernel/eas/task_boost_limit 460

    write /sys/class/devfreq/ddrfreq/min_freq 0
    write /sys/class/devfreq/ddrfreq/max_freq 0
    write /sys/class/devfreq/ddrfreq_latency/min_freq 0
    write /sys/class/devfreq/ddrfreq_latency/max_freq 0
    write /sys/class/devfreq/ddrfreq_up_threshold/max_freq 1866000000
    write /sys/class/devfreq/ddrfreq_up_threshold/min_freq 1866000000
    
    write /sys/kernel/rcc/event BOOT_COMPLETE
