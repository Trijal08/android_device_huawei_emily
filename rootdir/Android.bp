    name: "fstab.modem",
    src: "fstab.modem",
    vendor: true,
}

prebuilt_etc {
    name: "ueventd.kirin970.rc",
    filename: "ueventd.rc",
    src: "etc/ueventd.kirin970.rc",
    vendor: true,
}
